<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | sort: 'date' | reverse %}
    {% assign news_limit = news.size %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% endif %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        <tbody>
          {% for item in news limit: news_limit %}
            <tr>
              <th scope="row">
                {% if item.display_date %}
                  {{ item.display_date | escape }}
                {% else %}
                  <time datetime="{{ item.date | date: '%Y-%m-%d' }}">
                    {{ item.date | date: '%b %d, %Y' }}
                  </time>
                {% endif %}
                {% if item.date_note %}
                  <br>
                  <small>{{ item.date_note | escape }}</small>
                {% endif %}
              </th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
